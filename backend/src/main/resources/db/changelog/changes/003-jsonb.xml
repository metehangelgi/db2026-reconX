<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV009 — JSONB column on instruments (+ GIN index on Postgres)
 WHAT:    instruments.metadata as JSONB to hold per-asset-class detail
          (e.g. dividend yield, country, sector).
 HOW:     Postgres-only step; H2 dialect lacks JSONB. The precondition guards
          dialect so dev (H2) skips the column entirely.
 WHY:     Schemaless metadata avoids 12 columns that only apply to one asset
          class. Trade-off: validation moves to the app layer.
 OBSERVE: \d instruments shows metadata jsonb. EXPLAIN ANALYZE on a metadata
          ->> 'sector' lookup hits idx_instruments_metadata_gin.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="003-jsonb-on-instruments" author="trainer">
        <!-- H2 (MODE=PostgreSQL) supports the JSONB column type and this exact
             DEFAULT '{}'::JSONB cast syntax too, so this runs on every dbms -
             the entity's @Type(JsonBinaryType.class) column needs to exist in
             dev (H2) as well as uat/prod (Postgres), or Hibernate's
             ddl-auto=validate fails at boot with a missing-column error.

             KNOWN LIMITATION (not fixed here): on H2, reading this column
             back through Hypersistence Utils' JsonBinaryType throws
             "cannot be transformed to Json object" — H2's JDBC driver
             returns the JSON text *quoted* (getString() on an empty object
             yields the 3 characters "{}", not Postgres's unquoted `{}`),
             and JsonJavaTypeDescriptor.fromString() can't parse a quoted
             string as JSON. A plain VARCHAR column with a matching default
             fixes the read (verified locally), but ddl-auto=validate then
             rejects it at boot ("found [character varying], but expecting
             [jsonb]") since @Column(columnDefinition = "jsonb") is a single
             annotation shared across all profiles. Properly fixing this
             needs either a dialect-aware JSON mapping (e.g. Hibernate 6's
             native @JdbcTypeCode(SqlTypes.JSON) instead of Hypersistence
             Utils) or a profile-specific entity mapping — out of scope for
             this pass. Net effect: reading an Instrument through JPA (e.g.
             any endpoint that loads a trade's instrument) throws on the
             `dev` (H2) profile specifically; the Testcontainers/Postgres
             path this project actually tests against is unaffected. -->
        <sql>ALTER TABLE instruments ADD COLUMN metadata JSONB DEFAULT '{}'::JSONB NOT NULL;</sql>
        <rollback>
            <sql>ALTER TABLE instruments DROP COLUMN metadata;</sql>
        </rollback>
    </changeSet>

    <changeSet id="003-jsonb-on-instruments-gin-index" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <sql>CREATE INDEX idx_instruments_metadata_gin ON instruments USING GIN (metadata jsonb_path_ops);</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS idx_instruments_metadata_gin;</sql>
        </rollback>
    </changeSet>


</databaseChangeLog>
